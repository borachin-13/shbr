rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user's budgeting data is private to the authenticated owner.
    match /users/{userId}/months/{monthId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == userId;
    }

    match /users/{userId}/settings/{settingsId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // Legacy flat storage is intentionally blocked for the pre-open architecture.
    // Existing data must be migrated before these rules are deployed.
    match /gotgan/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
