rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Username lookup is required before Firebase email/password login.
    // The document contains only a username -> UID mapping, not private profile data.
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // User profile documents are private to the authenticated owner.
    match /users/{userId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == userId;
    }

    match /users/{userId}/months/{monthId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == userId;
    }

    match /users/{userId}/settings/{settingsId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // Legacy flat storage is intentionally blocked.
    match /gotgan/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
